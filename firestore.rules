rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function mine(uid) { return signed() && request.auth.uid == uid; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function active() {
      return signed() && exists(userPath(request.auth.uid)) &&
        get(userPath(request.auth.uid)).data.deleting == false;
    }
    function groupPath(gid) { return /databases/$(database)/documents/groups/$(gid); }
    function memberPath(gid, uid) { return /databases/$(database)/documents/groups/$(gid)/members/$(uid); }
    function indexPath(gid, uid) { return /databases/$(database)/documents/users/$(uid)/memberships/$(gid); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    function member(gid) { return signed() && exists(memberPath(gid, request.auth.uid)); }
    function group(gid) { return get(groupPath(gid)).data; }
    function owner(gid) { return member(gid) && group(gid).ownerUid == request.auth.uid; }
    function admin(gid) {
      return owner(gid) || (member(gid) && get(memberPath(gid, request.auth.uid)).data.role == 'admin');
    }
    function editing(gid) { return active() && member(gid) && group(gid).closing == false; }
    function closingOwner(gid) { return owner(gid) && group(gid).closing == true; }
    function keys(data, names) { return data.keys().hasAll(names) && data.keys().hasOnly(names); }
    function text(value, low, high) { return value is string && value.size() >= low && value.size() <= high; }
    function code(value) { return value is string && value.matches('^[A-F0-9]{32}$'); }
    function amount(value) { return value is int && value >= 1 && value <= 100000000; }
    function revision(d) { return d.revision is int && d.revision >= 1 && d.revision < 1000000; }
    function destination(value) { return value is string && value.matches('^[a-z0-9-]{1,60}$'); }
    function tripDate(value) {
      return value is string && value.matches('^[1-9][0-9]{3}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    function nicknameMatches(uid, value) { return get(userPath(uid)).data.nickname == value; }

    match /users/{uid} {
      function profile(d) {
        return keys(d, ['nickname','deleting']) && text(d.nickname,1,40) && d.deleting is bool;
      }
      allow get: if mine(uid);
      allow create: if mine(uid) && profile(request.resource.data) && request.resource.data.deleting == false;
      allow update: if mine(uid) && profile(request.resource.data) && resource.data.deleting == false;
      allow delete: if mine(uid) && resource.data.deleting == true;

      match /items/{item} {
        allow read, delete: if mine(uid);
        allow create, update: if mine(uid) && active() &&
          text(item,1,1200) &&
          keys(request.resource.data,['kind','key','payload']) &&
          request.resource.data.kind in ['saved','compare','attractions','checks','notes','plans','budget'] &&
          text(request.resource.data.key,1,200) && text(request.resource.data.payload,1,40000);
      }
      match /memberships/{gid} {
        allow read: if mine(uid);
        allow create: if mine(uid) && existsAfter(memberPath(gid,uid)) &&
          keys(request.resource.data,['joinedAt']) && request.resource.data.joinedAt == request.time;
        allow delete: if mine(uid) && !existsAfter(memberPath(gid,uid));
      }
    }

    match /invites/{entry} {
      allow get: if active();
      allow create: if active() && code(entry) &&
        keys(request.resource.data,['groupId']) && text(request.resource.data.groupId,1,100) &&
        getAfter(groupPath(request.resource.data.groupId)).data.inviteCode == entry &&
        (
          (!exists(groupPath(request.resource.data.groupId)) &&
            getAfter(groupPath(request.resource.data.groupId)).data.ownerUid == request.auth.uid) ||
          admin(request.resource.data.groupId)
        );
      allow delete: if admin(resource.data.groupId) && (
        !existsAfter(groupPath(resource.data.groupId)) ||
        getAfter(groupPath(resource.data.groupId)).data.inviteCode != entry
      );
    }

    match /groups/{gid} {
      function groupShape(d) {
        return d.keys().hasAll(['name','ownerUid','inviteCode','memberCount','closing','createdAt']) &&
          d.keys().hasOnly(['name','ownerUid','inviteCode','memberCount','closing','createdAt','travelDays','departure']) &&
          d.get('travelDays',3) is int && d.get('travelDays',3) >= 1 && d.get('travelDays',3) <= 365 &&
          (d.get('departure','') == '' || tripDate(d.departure)) &&
          text(d.name,1,70) && text(d.ownerUid,1,128) && code(d.inviteCode) &&
          d.memberCount is int && d.memberCount >= 1 && d.memberCount <= 30 &&
          d.closing is bool && d.createdAt is timestamp;
      }
      function fields() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function joinCount() {
        return active() && !member(gid) && existsAfter(memberPath(gid,request.auth.uid)) &&
          request.resource.data.memberCount == resource.data.memberCount + 1;
      }
      function leaveCount() {
        return member(gid) && !owner(gid) && !existsAfter(memberPath(gid,request.auth.uid)) &&
          request.resource.data.memberCount == resource.data.memberCount - 1;
      }
      allow get: if member(gid);
      allow create: if active() && groupShape(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.memberCount == 1 && request.resource.data.closing == false &&
        request.resource.data.createdAt == request.time &&
        existsAfter(memberPath(gid,request.auth.uid)) &&
        getAfter(invitePath(request.resource.data.inviteCode)).data.groupId == gid;
      allow update: if groupShape(request.resource.data) && resource.data.closing == false && (
        (fields().hasOnly(['memberCount']) && (joinCount() || leaveCount())) ||
        (active() && admin(gid) && fields().hasOnly(['inviteCode','name']) &&
          getAfter(invitePath(request.resource.data.inviteCode)).data.groupId == gid &&
          (request.resource.data.inviteCode == resource.data.inviteCode ||
            !existsAfter(invitePath(resource.data.inviteCode)))) ||
        (active() && admin(gid) && fields().hasOnly(['travelDays','departure'])) ||
        (owner(gid) && fields().hasOnly(['ownerUid']) &&
          exists(memberPath(gid,request.resource.data.ownerUid))) ||
        (owner(gid) && resource.data.memberCount == 1 &&
          fields().hasOnly(['closing']) && request.resource.data.closing == true)
      );
      allow delete: if closingOwner(gid) && resource.data.memberCount == 1 &&
        !existsAfter(memberPath(gid,request.auth.uid)) &&
        !existsAfter(invitePath(resource.data.inviteCode));

      match /members/{uid} {
        function memberShape(d) {
          return keys(d,['nickname','role','joinCode','joinedAt']) &&
            text(d.nickname,1,40) && d.role in ['member','admin'] &&
            code(d.joinCode) && d.joinedAt is timestamp;
        }
        function joining(d) {
          return group(gid).closing == false &&
            get(userPath(group(gid).ownerUid)).data.deleting == false &&
            group(gid).inviteCode == d.joinCode && get(invitePath(d.joinCode)).data.groupId == gid &&
            getAfter(groupPath(gid)).data.memberCount == group(gid).memberCount + 1;
        }
        allow read: if member(gid);
        allow create: if mine(uid) && active() && memberShape(request.resource.data) &&
          request.resource.data.role == 'member' && nicknameMatches(uid, request.resource.data.nickname) &&
          request.resource.data.joinedAt == request.time && existsAfter(indexPath(gid,uid)) &&
          ((!exists(groupPath(gid)) && getAfter(groupPath(gid)).data.ownerUid == uid &&
            getAfter(groupPath(gid)).data.inviteCode == request.resource.data.joinCode) || joining(request.resource.data));
        allow update: if memberShape(request.resource.data) && editing(gid) && (
          (mine(uid) && nicknameMatches(uid,request.resource.data.nickname) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])) ||
          (owner(gid) && group(gid).ownerUid != uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
        );
        allow delete: if mine(uid) && member(gid) && !existsAfter(indexPath(gid,uid)) &&
          !existsAfter(/databases/$(database)/documents/groups/$(gid)/votes/$(uid)) &&
          !existsAfter(/databases/$(database)/documents/groups/$(gid)/expenses/$(uid)) &&
          !existsAfter(/databases/$(database)/documents/groups/$(gid)/opinions/$(uid)) &&
          ((closingOwner(gid) && !existsAfter(groupPath(gid))) ||
            (!owner(gid) && getAfter(groupPath(gid)).data.memberCount == group(gid).memberCount - 1));
      }

      match /candidates/{id} {
        allow read: if member(gid);
        allow create: if editing(gid) && destination(id) &&
          keys(request.resource.data,['addedAt']) && request.resource.data.addedAt == request.time;
        allow delete: if closingOwner(gid) || (editing(gid) && admin(gid));
      }
      match /votes/{uid} {
        function validVote(d) {
          let date = d.get('date','');
          let ratings = d.get('ratings',{});
          return d.keys().hasAll(['destination','days']) &&
            d.keys().hasOnly(['destination','days','date','ratings']) &&
            d.days is int && d.days >= 0 && d.days <= 365 &&
            (d.destination == '' || (destination(d.destination) &&
              exists(/databases/$(database)/documents/groups/$(gid)/candidates/$(d.destination)))) &&
            (date == '' || (tripDate(date) &&
              exists(/databases/$(database)/documents/groups/$(gid)/dates/$(date)))) &&
            ratings is map && ratings.size() <= 100 && ratings.values().hasOnly([-1,1]);
        }
        allow read: if member(gid);
        allow create, update: if editing(gid) && mine(uid) && validVote(request.resource.data);
        allow delete: if member(gid) && mine(uid);
      }
      match /dates/{date} {
        allow read: if member(gid);
        allow create: if editing(gid) && tripDate(date) &&
          keys(request.resource.data,['addedAt']) && request.resource.data.addedAt == request.time;
        allow delete: if closingOwner(gid) || (editing(gid) && admin(gid));
      }
      match /checklist/{id} {
        function task(d) {
          return keys(d,['title','done','revision']) && text(d.title,1,100) && d.done is bool && revision(d);
        }
        allow read: if member(gid);
        allow create: if editing(gid) && task(request.resource.data) && request.resource.data.revision == 1;
        allow update: if editing(gid) && task(request.resource.data) &&
          request.resource.data.revision == resource.data.revision + 1;
        allow delete: if editing(gid) || closingOwner(gid);
      }
      match /places/{id} {
        function place(d) {
          return keys(d,['kind','title','memo','revision']) &&
            d.kind in ['spot','food'] && text(d.title,1,100) && text(d.memo,0,1000) && revision(d);
        }
        allow read: if member(gid);
        allow create: if editing(gid) && place(request.resource.data) && request.resource.data.revision == 1;
        allow update: if editing(gid) && place(request.resource.data) &&
          request.resource.data.revision == resource.data.revision + 1;
        allow delete: if editing(gid) || closingOwner(gid);
      }
      match /opinions/{uid} {
        allow read: if member(gid);
        allow create, update: if editing(gid) && mine(uid) &&
          keys(request.resource.data,['memo']) && text(request.resource.data.memo,1,1500);
        allow delete: if member(gid) && mine(uid);
      }
      match /schedule/{id} {
        function schedule(d) {
          return keys(d,['day','time','title','memo','revision']) && revision(d) &&
            d.day is int && d.day >= 1 && d.day <= getAfter(groupPath(gid)).data.get('travelDays',4) &&
            d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
            text(d.title,1,100) && text(d.memo,0,1000);
        }
        allow read: if member(gid);
        allow create: if editing(gid) && schedule(request.resource.data) && request.resource.data.revision == 1;
        allow update: if editing(gid) && schedule(request.resource.data) &&
          request.resource.data.revision == resource.data.revision + 1;
        allow delete: if editing(gid) || closingOwner(gid);
      }
      match /budget/{id} {
        function budget(d) {
          return d.keys().hasAll(['total','memo','revision']) &&
            d.keys().hasOnly(['total','memo','revision','nightly','foodDaily','transitDaily']) &&
            d.total is int && d.total >= 0 && d.total <= 100000000 &&
            d.get('nightly',0) is int && d.get('nightly',0) >= 0 && d.get('nightly',0) <= 100000000 &&
            d.get('foodDaily',0) is int && d.get('foodDaily',0) >= 0 && d.get('foodDaily',0) <= 100000000 &&
            d.get('transitDaily',0) is int && d.get('transitDaily',0) >= 0 && d.get('transitDaily',0) <= 100000000 &&
            text(d.memo,0,400) && revision(d);
        }
        allow read: if member(gid);
        allow create: if editing(gid) && id == 'shared' && budget(request.resource.data) &&
          request.resource.data.revision == 1;
        allow update: if editing(gid) && id == 'shared' && budget(request.resource.data) &&
          request.resource.data.revision == resource.data.revision + 1;
        allow delete: if closingOwner(gid);
      }
      match /expenses/{uid} {
        allow read: if member(gid);
        allow create, update: if editing(gid) && mine(uid) &&
          keys(request.resource.data,['entries']) &&
          request.resource.data.entries is list && request.resource.data.entries.size() <= 30 &&
          text(request.resource.data.entries.join(''),0,20000);
        allow delete: if member(gid) && mine(uid);
      }
    }
  }
}
